{
  "manifest_version": 3,
  "name": "VLL — Video Language Learner",
  "version": "1.5.0",
  "description": "Aprenda chinês no YouTube com legendas interativas (Hanzi, Pinyin e tradução), vocabulário colorido e exportação para o Anki.",
  "browser_specific_settings": {
    "gecko": {
      "id": "vll@geraldohomero.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://translate.google.com/*",
    "https://translate.googleapis.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/logger.shared.js",
      "src/messages.shared.js",
      "src/config.shared.js",
      "src/network.shared.js",
      "src/database.js",
      "src/dictionary.js",
      "src/export.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/logger.shared.js",
        "src/messages.shared.js",
        "src/config.shared.js",
        "src/network.shared.js",
        "src/vocab.shared.js",
        "src/subtitles.shared.js",
        "src/subtitles.js",
        "src/overlay.js",
        "src/tooltip.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "sidebar_action": {
    "default_panel": "src/sidepanel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "VLL — Side Panel"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/dictionary_*.json"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}