{
  "manifest_version": 3,
  "name": "VLL — Video Language Learner",
  "version": "1.3.9",
  "description": "Aprenda chinês no YouTube com legendas interativas (Hanzi, Pinyin e tradução), vocabulário colorido e exportação para o Anki.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://translate.google.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/logger.shared.js",
        "src/messages.shared.js",
        "src/config.shared.js",
        "src/network.shared.js",
        "src/vocab.shared.js",
        "src/subtitles.shared.js",
        "src/subtitles.js",
        "src/overlay.js",
        "src/tooltip.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/dictionary.json"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}